---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site.mjs';
import { SITE_NAME } from '../lib/brand.mjs';
const s = getSite();
const cities = s.cityPages.filter((p) => p.tier === 'indexable');
---
<Base title="Search this site" description={`Search companies, cities and guides on ${SITE_NAME}.`} noindex pageType="search" crumbs={[]}>
  <h1>Search this site</h1>
  <div id="search" data-pagefind-ignore></div>
  <p id="search-fallback" class="small">Search is not available right now. Browse the <a href="/site-map/">A to Z list of all pages</a>, or go to:
    {cities.map((c, i) => <>{i > 0 && ', '}<a href={c.path}>{c.geo.name}</a></>)}{s.nav.fees && <>{cities.length > 0 && ', '}<a href="/fees/">fee comparison</a></>}.</p>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    // Pagefind UI is loaded only on this page. It exists after `npm run build`; in dev the fallback text stays.
    window.addEventListener('DOMContentLoaded', function () {
      if (typeof PagefindUI === 'undefined') return;
      document.getElementById('search-fallback').hidden = true;
      var ui = new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false });
      // Pagefind's input has no visible label of its own: add one.
      var input = document.querySelector('#search .pagefind-ui__search-input');
      if (input) { input.id = 'site-search'; var l = document.createElement('label'); l.htmlFor = 'site-search'; l.textContent = 'Search the site'; input.parentNode.insertBefore(l, input); }
      var q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    });
  </script>
</Base>
