---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site.mjs';
import { fmtDate } from '../lib/fees.mjs';
// Public log of applied corrections. It holds no requester data (see schemas/corrections-log.schema.json). A noindex utility page.
const s = getSite();
const log = [...(s.data['corrections-log'] || [])].sort((a, b) => b.date.localeCompare(a.date) || b.id.localeCompare(a.id));
const label = { corrected: 'Corrected', added: 'Added', removed: 'Removed' };
---
<Base title="Corrections log" description="Corrections applied to this site, with the date and what changed. No requester details." noindex pageType="corrections-log" crumbs={[{ name: 'Corrections', href: '/corrections/' }, { name: 'Corrections log' }]}>
  <h1>Corrections log</h1>
  <p class="lede">Every correction we apply is listed here with the date and what changed. It never shows who asked.</p>
  {log.length === 0 ? (
    <p>No corrections have been applied yet. <a href="/corrections/">Correct or remove a listing</a>.</p>
  ) : (
    <div class="fee-wrap" tabindex="0" role="region" aria-label="Corrections applied to this site">
      <table class="table-simple">
        <caption class="sr">Corrections applied to this site</caption>
        <thead><tr><th scope="col">Date</th><th scope="col">Company</th><th scope="col">Change</th><th scope="col">What changed</th></tr></thead>
        <tbody>
          {log.map((e) => (
            <tr>
              <td><time datetime={e.date}>{fmtDate(e.date)}</time></td>
              <td>{e.company_name ?? (e.type === 'removed' ? 'Listing removed on request' : 'Not named')}</td>
              <td>{label[e.type]}</td>
              <td>{e.what_changed}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="small muted">Removals are logged without the company's name. <a href="/corrections/">How corrections work</a>.</p>
</Base>
