---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site.mjs';
const s = getSite();
---
<Base title="Page not found" description="This page does not exist or has been removed." noindex pageType="404">
  <h1>Page not found</h1>
  <p>This page does not exist, or a listing was removed at the owner's request.</p>
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/search/">Search this site</a></li>
    {s.nav.fees && <li><a href="/fees/">Compare fees</a></li>}
    <li><a href="/corrections/">Correct or remove a listing</a></li>
  </ul>
</Base>
