---
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import Badge from '../../components/Badge.astro';
import FeeValue from '../../components/FeeValue.astro';
import SourceNote from '../../components/SourceNote.astro';
import { getSite } from '../../lib/site.mjs';
import { FEE_GUIDES, feeTypeBySlug } from '../../lib/feeguides.mjs';
import { feeValuePopulated } from '../../lib/gate.mjs';
import { buildFeeRows, rangeSummary } from '../../lib/feetable.mjs';
import { EXAMPLE_RENT, amountAtText } from '../../lib/estimate.mjs';
// One page per fee type that 5+ companies publish (quality gate), plus the hub when at least one guide exists.
export function getStaticPaths() {
  const s = getSite();
  const out = [];
  if (s.planned.find((p) => p.type === 'fee-guide-hub').eligible) out.push({ params: { slug: undefined } });
  for (const p of s.planned.filter((x) => x.type === 'fee-guide' && x.eligible)) out.push({ params: { slug: FEE_GUIDES[p.fee_type].slug } });
  return out;
}
const s = getSite();
const flag = s.quality.freshness.displayFlagDays;
const type = Astro.params.slug ? feeTypeBySlug(Astro.params.slug) : null;
const gates = s.planned.filter((p) => p.type === 'fee-guide');
const eligible = gates.filter((p) => p.eligible);
const g = type ? FEE_GUIDES[type] : null;
const rows = type ? buildFeeRows(s, s.feeRows.filter((f) => feeValuePopulated(f[type]))) : [];
const companiesN = new Set(rows.map((r) => r.company.id)).size;
const summary = type ? rangeSummary(rows, type) : [];
const latest = rows.map((r) => r.fee.last_verified_date).sort().at(-1);
const others = eligible.filter((p) => p.fee_type !== type);
const TOC = [['published', 'What companies we reviewed publish'], ['example', 'At an example rent'], ['questions', 'Questions to ask a company'], ['sources', 'Sources']];
const jsonLd = type ? { '@context': 'https://schema.org', '@type': 'Article', headline: g.title, description: g.definition, dateModified: latest, inLanguage: 'en-US', mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href } : undefined;
---
{!type ? (
  <Base title="Fee guides: what Columbus managers publish" description="Guides to the fees Columbus-area property management companies publish: what each fee is, the range the companies we reviewed publish, and the source for every figure." pageType="fee-guide" crumbs={[{ name: 'Fee guides' }]}>
    <h1>Fee guides: what Columbus property managers publish</h1>
    <p class="lede">One guide per fee type. Each shows only what the companies we reviewed publish on their own websites, with the source and date for every figure.</p>
    <Banner kind="info" lead="Companies we reviewed, not a market average.">We publish a guide for a fee type only when at least {s.quality.feeGuide.minCompaniesPerFeeType} companies publish it.</Banner>
    <ul>{eligible.map((p) => <li><a href={p.path}>{FEE_GUIDES[p.fee_type].title}</a> ({p.count} companies)</li>)}</ul>
    <h2>How many companies publish each fee</h2>
    <ul>{gates.map((p) => <li>{FEE_GUIDES[p.fee_type].short}: {p.count} {p.count === 1 ? 'company' : 'companies'} publish it. {p.eligible ? <a href={p.path}>Read the guide</a> : `A guide is published at ${p.need} companies.`}</li>)}</ul>
    {s.nav.fees && <p><a href="/fees/">Compare fees company by company</a></p>}
  </Base>
) : (
  <Base title={g.title} description={`What ${companiesN} Columbus-area property management companies publish for ${g.short.toLowerCase()}, with the source and date for every figure.`} jsonLd={jsonLd} pageType="fee-guide" crumbs={[{ name: 'Fee guides', href: '/fee-guide/' }, { name: g.short }]}>
    <h1>{g.title}</h1>
    <p class="lede">{g.definition}</p>
    <p class="small muted">Data last verified: <time datetime={latest}>{latest}</time>. <a href="/methodology/">Methodology</a>. General information, not legal advice.</p>
    <nav class="toc" aria-label="On this page"><ol>{TOC.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol></nav>

    <h2 id="published">What companies we reviewed publish</h2>
    <Banner kind="info" lead="Companies we reviewed, not a market average.">{companiesN} companies publish a {g.short.toLowerCase()} on their own websites. It is not a survey and says nothing about companies that do not publish it.</Banner>
    <ul>{summary.map((x) => <li>{x.companies} of {companiesN} state it as {x.label}: {x.text}.</li>)}</ul>
    <div class="fee-wrap" tabindex="0" role="region" aria-label={`${g.short} published by ${companiesN} companies. Scrolls sideways on small screens.`}>
      <table class="fee-table">
        <caption class="sr">{g.short} published by {companiesN} companies we reviewed</caption>
        <thead><tr><th scope="col">Company</th><th scope="col">Amount and basis</th><th scope="col">Fees for</th><th scope="col">Last verified and source</th></tr></thead>
        <tbody>
          {rows.map((r) => { const b = r.badge; return (
            <tr>
              <th scope="row">{r.path ? <a href={r.path}>{r.company.name}</a> : r.company.name}</th>
              <td><span class="lbl">Amount and basis</span><FeeValue value={r.fee[type]} showNotes /></td>
              <td><span class="lbl">Fees for</span><span class="v">{r.ptName ?? 'No property type stated'}</span></td>
              <td><span class="lbl">Last verified and source</span><span class="v"><Badge kind={b.kind} text={b.text} /><SourceNote sourceId={r.fee.source_id} captured={r.fee.captured_date} verified={r.fee.last_verified_date} urls={r.fee.source_urls} /></span></td>
            </tr>
          ); })}
        </tbody>
      </table>
    </div>

    <h2 id="example">At an example rent</h2>
    <p>An illustration only: ${EXAMPLE_RENT.toLocaleString('en-US')} is a round example, not a Columbus average or median. Percent values are applied to it as published, with any dollar minimum honored. Ranges stay ranges.</p>
    <ul>{rows.map((r) => <li>{r.company.name}{r.ptName ? ` (${r.ptName})` : ''}: {amountAtText(r.fee[type], EXAMPLE_RENT)}</li>)}</ul>

    <h2 id="questions">Questions to ask a company</h2>
    <ul>{g.questions.map((q) => <li>{q}</li>)}</ul>

    <h2 id="sources">Sources</h2>
    <ul class="sources">{rows.map((r) => <li>{r.company.name}: <SourceNote sourceId={r.fee.source_id} captured={r.fee.captured_date} verified={r.fee.last_verified_date} urls={r.fee.source_urls} /></li>)}</ul>

    <h2>Related</h2>
    <ul>
      {s.nav.fees && <li><a href="/fees/">Compare all fees side by side</a></li>}
      {others.map((p) => <li><a href={p.path}>{FEE_GUIDES[p.fee_type].title}</a></li>)}
      <li><a href="/fee-guide/">All fee guides</a></li>
      <li>Wrong figure? <a href="/corrections/">Correct or remove a listing</a>.</li>
    </ul>
  </Base>
)}
