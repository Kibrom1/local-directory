---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site.mjs';
import { SITE_NAME } from '../lib/brand.mjs';
import { fmtDate } from '../lib/fees.mjs';
const s = getSite();
const cities = s.cityPages.filter((p) => p.tier !== 'placeholder');
const byName = (a, b) => a.name.localeCompare(b.name);
const companies = s.companyPages.filter((p) => p.tier !== 'placeholder').map((p) => ({ name: p.company.name, href: p.path })).sort(byName);
const indexable = s.companyPages.filter((p) => p.tier === 'indexable').length;
// Property types that at least one listed company serves (from sourced facts).
const served = new Set(s.companyPages.filter((p) => p.tier !== 'placeholder').flatMap((p) => p.company.property_types_served.map((x) => x.property_type_id)));
const types = [...s.ptById.values()].filter((t) => served.has(t.id));
const guides = s.guidePages.filter((g) => g.tier === 'indexable').slice(0, 3);
// Coverage, stated plainly: what exists, what does not yet, and why. Counts come from the same gate that builds the pages.
const recorded = s.data.companies.filter((c) => !c.placeholder && c.evidence_level === 'own_site_confirmed').length;
const publishedProfiles = s.companyPages.filter((x) => x.tier !== 'placeholder').length;
const feeCompanies = s.companiesWithFees.size;
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL('/', Astro.site).href, potentialAction: { '@type': 'SearchAction', target: new URL('/search/?q={query}', Astro.site).href.replace('%7Bquery%7D', '{query}'), 'query-input': 'required name=query' } };
---
<Base title="Find and compare Columbus-area property managers" description="A free, independent directory of Columbus-area property management companies. Fees, services and service areas, each fact with its source and date." jsonLd={jsonLd} pageType="home">
  <section class="hero" aria-labelledby="home-h">
    <div class="hero-in">
      <p class="eyebrow">Central Ohio &middot; Franklin, Delaware, Fairfield, Licking</p>
      <h1 id="home-h">Find and compare Columbus-area property managers</h1>
      <p class="lede">Free and independent. Each fee, service area and license note shows where it came from and when we checked it.</p>
      <ul class="trust-row">
        {['No paid listings', 'No ads or accounts', 'Fees never change order'].map((t) => <li><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor" stroke-width="2"/></svg>{t}</li>)}
        {s.lastDataUpdate && <li><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 5" fill="none" stroke="currentColor" stroke-width="2"/></svg>Data updated <time datetime={s.lastDataUpdate}>{fmtDate(s.lastDataUpdate)}</time></li>}
      </ul>
    </div>
  </section>

  {cities.length > 1 && (
    <form id="find-form" class="finder filters js-only" aria-label="Find property management companies">
      <div class="field"><label for="city">City</label>
        <select id="city" name="city">{cities.map((c) => <option value={c.geo.slug}>{c.geo.name}, {c.geo.state}</option>)}</select></div>
      <div class="field"><label for="type">Property type</label>
        <select id="type" name="type"><option value="">Any property type</option>{types.map((t) => <option value={t.slug}>{t.name}</option>)}</select></div>
      <div class="field"><button class="btn" type="submit">Show companies</button></div>
    </form>
  )}
  <form action="/search/" method="get" role="search" aria-label="Search this site" class="field js-only mt-6">
    <label for="q">Search the site</label>
    <div class="searchrow"><input id="q" name="q" type="search" autocomplete="off" /><button class="btn secondary" type="submit">Search</button></div>
  </form>
  <p class="small"><a href="/site-map/">All pages on this site, A to Z</a></p>

  <section class="coverage" aria-labelledby="coverage-h">
    <h2 id="coverage-h">What this site covers today</h2>
    <p>{plural(recorded, 'company is', 'companies are')} in our records. {publishedProfiles === 0 ? 'None has a published profile yet' : `${plural(publishedProfiles, 'has a published profile', 'have published profiles')}`}, because a profile is published only when it has enough sourced, recent facts. {s.termsGateOn && publishedProfiles > indexable ? 'Profiles whose sources\' terms a person has not read yet are published but kept out of search engines. ' : ''}{feeCompanies > 0 ? `${plural(feeCompanies, 'company publishes', 'companies publish')} fees we can compare.` : 'No fee comparison is published yet.'}</p>
    <p>Know a company we missed, or a fact that is wrong? <a href="/corrections/">Tell us</a>. No account is needed.</p>
  </section>

  <div class="grid cols-3 mt-8">
    <div class="card"><h2 class="card-title">See what companies charge</h2><p>{s.nav.fees ? <>{plural(feeCompanies, 'company publishes', 'companies publish')} fees we can compare, each with its basis, source and date. <a href="/fees/">Compare fees</a></> : 'A fee table appears here once enough companies publish comparable fees.'}</p></div>
    <div class="card"><h2 class="card-title">Find companies near you</h2><p>{cities.length ? <>{plural(cities.length, 'city page is', 'city pages are')} published so far. <a href="#cities">Browse by city</a></> : 'City pages appear once at least three companies with sourced data serve a city.'}</p></div>
    <div class="card"><h2 class="card-title">Learn what a fee covers</h2><p>{s.nav.feeGuides || guides.length ? <>Plain-language guides built from what the companies we reviewed publish. <a href={s.nav.feeGuides ? '/fee-guide/' : guides[0].path}>{s.nav.feeGuides ? 'Fee guides' : 'Landlord guides'}</a></> : 'Guides appear here once enough sourced facts are published.'}</p></div>
  </div>

  <h2 id="cities">Browse by city</h2>
  {cities.length ? (
    <>
    <div class="grid cols-3 city-grid">{cities.filter((p) => p.withFees > 0).map((p) => { const n = p.companies.length + p.listedCompanies.length; return (
      <a class="card city-card" href={p.path}><h3>{p.geo.name}, {p.geo.state}</h3><span class="n">{n}</span> {n === 1 ? 'company serves' : 'companies serve'} it, {p.withFees} {p.withFees === 1 ? 'publishes' : 'publish'} fees</a>
    ); })}</div>
    {cities.some((p) => p.withFees === 0) && <><p class="mt-6">Cities where we have not yet read any published fees:</p><ul class="pill-list">{cities.filter((p) => p.withFees === 0).map((p) => <li><a href={p.path}>{p.geo.name} ({p.companies.length + p.listedCompanies.length})</a></li>)}</ul></>}
    </>
  ) : <p>City pages appear once at least three companies with sourced data serve a city.</p>}

  {companies.length > 0 && (
    <>
      <h2 id="companies">Companies in our records</h2>
      <p class="small muted">In A to Z order. Order never reflects fees, payment or quality.</p>
      <ul class="pill-list">{companies.map((c) => <li><a href={c.href}>{c.name}</a></li>)}</ul>
    </>
  )}

  {(guides.length > 0 || s.nav.feeGuides) && (
    <>
      <h2>For landlords</h2>
      <ul>
        {s.nav.feeGuides && <li><a href="/fee-guide/">Fee guides</a>: what the companies we reviewed publish for each fee type</li>}
        {guides.map((g) => <li><a href={g.path}>{g.guide.title}</a></li>)}
      </ul>
    </>
  )}

  <h2>Own or run a listed company?</h2>
  <p>Fix a wrong fact or have your listing removed, free and without an account. <a href="/corrections/">Correct or remove a listing</a></p>
  <script>import '../scripts/find.js';</script>
</Base>
