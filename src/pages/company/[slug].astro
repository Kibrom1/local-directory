---
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import Badge from '../../components/Badge.astro';
import FeeValue from '../../components/FeeValue.astro';
import SourceNote from '../../components/SourceNote.astro';
import Unknown from '../../components/Unknown.astro';
import { getSite } from '../../lib/site.mjs';
import { describeFee, minimumsText, freshnessBadge, feeBadge, fmtDate, unknownKind, scopeCaveat, licenseBadge, LICENSE_EXPLANATION } from '../../lib/fees.mjs';
import { formatFee, feeText } from '../../lib/format.mjs';
import { FEE_GUIDES } from '../../lib/feeguides.mjs';
export function getStaticPaths() {
  return getSite().companyPages.map((p) => ({ params: { slug: p.company.slug }, props: { page: p } }));
}
const s = getSite();
const flag = s.quality.freshness.displayFlagDays;
const { company: c, areas, robots, tier, verifiedFeeRows } = Astro.props.page;
const fees = verifiedFeeRows; // verified, fresh, from an allowed source, with at least one value
const dropped = Astro.props.page.fees.filter((f) => !s.fresh(f.last_verified_date) && s.quality.verifiedFeeStatuses.includes(f.verification_status));
const staleFee = fees.filter((f) => freshnessBadge(f.last_verified_date, s.today, flag).kind === 'stale');
const newest = [...fees].sort((a, b) => b.last_verified_date.localeCompare(a.last_verified_date))[0];
const fb = newest ? feeBadge(newest, s.today, flag) : freshnessBadge(c.last_verified_date, s.today, flag);
const lb = licenseBadge(c.license, s.today);
const FEE_ROWS = [['Management fee', 'management_pct'], ['Flat fee', 'flat_fee'], ['Leasing fee', 'leasing_fee'], ['Renewal fee', 'renewal_fee']];
const addressText = c.address && (c.address.street || c.address.city) ? [c.address.street, c.address.city, c.address.state, c.address.zip].filter(Boolean).join(', ') : null;
const host = c.website ? new URL(c.website).host.replace(/^www\./, '') : null;
const types = c.property_types_served.map((x) => s.ptById.get(x.property_type_id)).filter(Boolean);
const cityPageFor = (g) => s.cityPages.find((p) => p.geo.id === g.id && p.tier !== 'placeholder');
const ptPages = types.map((t) => s.planned.find((p) => p.type === 'property-type' && p.property_type_id === t.id && p.eligible)).filter(Boolean);
const pretty = (x) => x.replace(/-/g, ' ').replace(/^./, (m) => m.toUpperCase()).replace(/\bhoa\b/gi, 'HOA');
const lede = [
  areas.length ? `${c.name} lists ${areas.map((g) => g.name).join(', ')} as ${areas.length === 1 ? 'its service area' : 'its service areas'}.` : `${c.name} has no service area recorded in our data yet.`,
  types.length ? `Property types stated: ${types.map((t) => t.name.toLowerCase()).join(', ')}.` : null,
  fees.length ? 'Fees below are as published by the company, not a quote.' : 'We have no fee data recorded for this company yet.'
].filter(Boolean).join(' ');
// F9: questions come only from the gaps in our own data: each fee type with no published value becomes one question to ask the company.
const gapQuestions = fees.length ? FEE_ROWS.filter(([, k]) => !fees.some((f) => describeFee(f[k]))).map(([, k]) => `What is your ${FEE_GUIDES[k].short.toLowerCase()}, and what does it cover?`) : [];
const correct = `/corrections/?company=${encodeURIComponent(c.name)}`;
const jsonLd = tier === 'indexable' ? {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': new URL(Astro.url.pathname, Astro.site).href + '#business',
  name: c.name, url: c.website || undefined, telephone: c.phone || undefined,
  address: c.address && (c.address.street || c.address.zip) ? { '@type': 'PostalAddress', streetAddress: c.address.street || undefined, addressLocality: c.address.city || undefined, addressRegion: c.address.state || undefined, postalCode: c.address.zip || undefined, addressCountry: 'US' } : undefined,
  areaServed: areas.map((g) => ({ '@type': 'City', name: g.name }))
} : undefined;
const toc = [['fees', 'Fees'], ['license', 'License'], ['areas', 'Service areas'], ['services', 'Services and property types'], ['contact', 'Contact'], ['correct', 'Correct or remove']];
---
<Base title={`${c.name}: fees and service areas`} description={`${c.name}: published fees with sources and dates, license note and service areas in the Columbus, Ohio area.`} robots={robots} jsonLd={jsonLd} pageType="company" crumbs={[{ name: c.name }]}>
  <h1>{c.name}</h1>
  {tier === 'placeholder' && <Banner kind="warn" lead="Test data.">This page uses test records and is not indexed.</Banner>}
  <div class="meta spaced">
    <Badge kind={lb.kind} text={lb.text} />
    <Badge kind={fb.kind} text={newest ? fb.text : `Listing ${fb.text.toLowerCase()}`} />
    {c.website && <a href={c.website} rel="nofollow noopener">Visit company website<span class="sr"> for {c.name}</span> ({host})</a>}
    <a href={correct}>Correct or remove this listing</a>
  </div>
  {staleFee.length > 0 && <Banner kind="warn" lead={`${feeBadge(staleFee[0], s.today, flag).text}.`}>They may have changed. Check the company site before relying on them.</Banner>}
  <p class="lede">{lede}</p>
  <dl class="snap" aria-label="At a glance">
    <div><dt class="k">Fees last read</dt><dd>{newest ? fmtDate(newest.last_verified_date) : 'Not recorded'}</dd></div>
    <div><dt class="k">Fee types published</dt><dd>{fees.length ? `${FEE_ROWS.filter(([, k]) => fees.some((f) => describeFee(f[k]))).length} of ${FEE_ROWS.length}` : 'Not recorded'}</dd></div>
    <div><dt class="k">Service areas</dt><dd>{areas.length ? areas.map((g) => g.name).join(', ') : 'Not recorded'}</dd></div>
    <div><dt class="k">Property types</dt><dd>{types.length ? types.map((t) => t.name).join(', ') : 'Not recorded'}</dd></div>
  </dl>
  <nav class="toc" aria-label="On this page"><ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol></nav>

  <h2 id="fees">Fees</h2>
  {fees.length === 0 ? (
    <p><Unknown kind="not_recorded" /> We have no fee data recorded for this company. Fees may exist on its own website. {dropped.length > 0 ? 'Earlier values are listed below.' : ''}</p>
  ) : (
    <>
      <p class="small muted">Published by the company, not a quote. Ranges and plans are shown as published, never averaged.{s.nav.fees && <> <a href="/fees/">Compare fees across companies</a>.</>}</p>
      {fees.map((f) => {
        const pt = f.property_type ? s.ptById.get(f.property_type).name : null;
        return (
          <section>
            <h3>{pt ? `Fees for ${pt}` : 'Fees (no property type stated)'}</h3>
            {scopeCaveat(f) && <Banner kind="warn" lead="Read this first.">{scopeCaveat(f)}</Banner>}
            <div class="fee-wrap">
              <table class="fee-table">
                <caption class="sr">Published fees for {c.name}{pt ? `, ${pt}` : ''}</caption>
                <thead><tr><th scope="col">Item</th><th scope="col">Amount and basis</th></tr></thead>
                <tbody>
                  {FEE_ROWS.map(([label, k]) => (
                    <tr>
                      <th scope="row">{label}</th>
                      <td><span class="lbl">Amount and basis</span>{describeFee(f[k]) ? <FeeValue value={f[k]} showNotes /> : <span class="v"><FeeValue value={f[k]} showNotes /><span class="src">Checked {fmtDate(f.last_verified_date)}: not on the pages we read.</span></span>}</td>
                    </tr>
                  ))}
                  <tr>
                    <th scope="row">Minimums</th>
                    <td><span class="lbl">Amount and basis</span><span class="v">{minimumsText(f.minimums) ?? <Unknown />}</span></td>
                  </tr>
                  {(f.other_fees || []).map((o) => (
                    <tr>
                      <th scope="row">{o.label || o.kind}</th>
                      <td><span class="lbl">Amount and basis</span><FeeValue value={o.amount} /></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <SourceNote sourceId={f.source_id} captured={f.captured_date} verified={f.last_verified_date} urls={f.source_urls} who={c.name} prefix="All rows above." />
            {f.notes && <p class="small muted">Note: {f.notes}</p>}
          </section>
        );
      })}
    </>
  )}
  {dropped.map((f) => (
    <p class="small">Last known: {FEE_ROWS.map(([label, k]) => feeText(f[k]) ? `${label} ${feeText(f[k])}` : null).filter(Boolean).join('; ')} (last read {fmtDate(f.last_verified_date)}). Not shown in comparisons until re-checked.</p>
  ))}

  {gapQuestions.length > 0 && (
    <>
      <h3>Not published by this company</h3>
      <p class="small muted">We found no figure for these on the company's own pages, so they are worth asking about directly:</p>
      <ul>{gapQuestions.map((q) => <li>{q}</li>)}</ul>
    </>
  )}

  <h2 id="license">License</h2>
  <p><Badge kind={lb.kind} text={lb.text} /></p>
  {c.license && c.license.status === 'self_stated' && <p>The company's website says: &ldquo;{c.license.claim_text}&rdquo;{c.license.number ? ` (number given: ${c.license.number})` : ''}. We have not checked this against the state record.</p>}
  {c.license && ['active', 'inactive', 'none_found'].includes(c.license.status) && <p>Checked against {c.license.issuing_body || 'the state record'}{c.license.number ? `, number ${c.license.number}` : ''}.</p>}
  <p>{LICENSE_EXPLANATION} This is general information, not legal advice.</p>
  {c.license && c.license.status !== 'unverified' ? <p><SourceNote sourceId={c.license.source_id} captured={c.license.captured_date} verified={c.license.last_verified_date} urls={[c.license.source_url]} who={c.name} /></p> : <p class="small muted">Nothing about a license was recorded from the company's website, and we have not checked the state record.</p>}

  <h2 id="areas">Service areas</h2>
  {areas.length ? (
    <>
      <ul>{areas.map((g) => { const cp = cityPageFor(g); return <li>{cp ? <a href={cp.path}>{g.name}, {g.state}</a> : <>{g.name}{g.type === 'city' ? `, ${g.state}` : ''}</>}</li>; })}</ul>
      <p class="small muted">As stated on the company's own website.</p>
    </>
  ) : <p><Unknown kind={unknownKind(c, 'service_areas')} /></p>}

  <h2 id="services">Services and property types</h2>
  <h3>Property types</h3>
  {types.length ? <ul>{types.map((t) => { const pp = ptPages.find((p) => p.property_type_id === t.id); return <li>{pp ? <a href={pp.path}>{t.name}</a> : t.name}</li>; })}</ul> : <p><Unknown kind={unknownKind(c, 'property_types')} /></p>}
  <h3>Services</h3>
  {c.services.length ? <ul>{c.services.map((x) => <li>{pretty(x.service)}</li>)}</ul> : <p><Unknown kind={unknownKind(c, 'services')} /></p>}

  <h2 id="contact">Contact</h2>
  <p class="small muted">Public business details only, as the company publishes them. Nothing is routed through this site.</p>
  <ul>
    <li>Website: {c.website ? <a href={c.website} rel="nofollow noopener">Visit company website<span class="sr"> for {c.name}</span></a> <span class="muted">({host})</span> : <Unknown kind={unknownKind(c, 'website')} />}</li>
    <li>Phone: {c.phone ? <a href={`tel:${c.phone.replace(/[^\d+]/g, '')}`}>{c.phone}</a> : <Unknown kind={unknownKind(c, 'phone')} />}</li>
    <li>Address: {addressText ?? <Unknown kind={unknownKind(c, 'address')} />}</li>
  </ul>
  <p><SourceNote sourceId={c.source_id} captured={c.captured_date} verified={c.last_verified_date} urls={[c.source_url]} who={c.name} /></p>

  <Banner kind="info" lead="Is this your company?" id="correct">
    Correct a fact or remove this listing, free and without an account. Correcting or claiming a listing never changes its position.
    <a href={correct}>Correct this listing</a> or <a href={`/corrections/?type=remove&company=${encodeURIComponent(c.name)}`}>request removal</a>.
  </Banner>
</Base>
