---
import Base from '../../layouts/Base.astro';
import Unknown from '../../components/Unknown.astro';
import { getSite } from '../../lib/site.mjs';
import { feeText } from '../../lib/format.mjs';
export function getStaticPaths() {
  return getSite().cityPages.map((p) => ({ params: { slug: p.geo.slug }, props: { page: p } }));
}
const { page } = Astro.props;
const { geo, companies, listedCompanies, robots, tier } = page;
const all = [...companies, ...listedCompanies];
const firstFee = (rows, k) => { for (const f of rows) { const t = feeText(f[k]); if (t) return t; } return null; };
---
<Base title={`Property management companies in ${geo.name}, ${geo.state}`} description={`${all.length} property management companies serving ${geo.name}, with sourced fee data where published.`} robots={robots}>
  <h1>Property management in {geo.name}, {geo.state}</h1>
  {tier === 'placeholder' && <p class="banner">Placeholder data only.</p>}
  <table>
    <thead><tr><th>Company</th><th>Management fee</th><th>Flat fee</th><th>Leasing fee</th><th>License</th></tr></thead>
    <tbody>
      {companies.map(({ company, verifiedFeeRows }) => (
        <tr>
          <td><a href={`/company/${company.slug}/`}>{company.name}</a></td>
          <td>{firstFee(verifiedFeeRows, 'management_pct') ?? <Unknown />}</td>
          <td>{firstFee(verifiedFeeRows, 'flat_fee') ?? <Unknown />}</td>
          <td>{firstFee(verifiedFeeRows, 'leasing_fee') ?? <Unknown />}</td>
          <td>{company.license && company.license.status !== 'unverified' ? (company.license.status === 'self_stated' ? 'Stated by the company, not checked' : company.license.status) : <Unknown />}</td>
        </tr>
      ))}
    </tbody>
  </table>
  {listedCompanies.length > 0 && (
    <>
      <h2>Also listed (limited published data)</h2>
      <ul>{listedCompanies.map(({ company }) => <li><a href={`/company/${company.slug}/`}>{company.name}</a></li>)}</ul>
    </>
  )}
</Base>
