---
import '../styles/site.css';
import { getSite } from '../lib/site.mjs';
import { SITE_NAME } from '../lib/brand.mjs';
import { fmtDate } from '../lib/fees.mjs';
interface Crumb { name: string; href?: string }
interface Props { title: string; description?: string; noindex?: boolean; robots?: string; jsonLd?: object | object[]; crumbs?: Crumb[]; pageType?: string; wide?: boolean; }
// robots overrides the default; pass 'noindex, follow' for listed pages, 'noindex, nofollow' for placeholders and drafts.
const { title, description = '', noindex = false, robots, jsonLd, crumbs = [], pageType = 'page' } = Astro.props;
const robotsValue = robots || (noindex ? 'noindex, nofollow' : '');
const isNoindex = robotsValue.startsWith('noindex');
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const gaId = import.meta.env.PUBLIC_GA_ID;
const s = getSite();

// Main navigation (UX spec section 3). A link exists only when its target page exists.
const nav = [
  s.nav.fees && { name: 'Compare fees', href: '/fees/', on: path.startsWith('/fees/') },
  s.nav.feeGuides && { name: 'Fee guides', href: '/fee-guide/', on: path.startsWith('/fee-guide/') },
  s.nav.guides && { name: 'Landlord guides', href: '/guides/', on: path.startsWith('/guides/') },
  { name: 'Cities', href: '/#cities', on: path.startsWith('/city/') },
  { name: 'About', href: '/about/', on: path === '/about/' }
].filter(Boolean);

const ld = [];
if (jsonLd) ld.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
if (crumbs.length && !isNoindex) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', href: '/' }, ...crumbs.filter((c, i) => c.href || i === crumbs.length - 1)].map((c, i, all) => ({
      '@type': 'ListItem', position: i + 1, name: c.name,
      item: i === all.length - 1 ? canonical : new URL(c.href, Astro.site).href
    }))
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {robotsValue && robotsValue !== 'index, follow' && <meta name="robots" content={robotsValue} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029')} />)}
    {gaId && <script is:inline define:vars={{ gaId }}>
      // GA4 loads after the page has loaded, with Google signals and ad personalization off (privacy page).
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId, { allow_google_signals: false, allow_ad_personalization_signals: false });
      window.addEventListener('load', function () {
        var g = document.createElement('script'); g.async = true;
        g.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
        document.head.appendChild(g);
      });
    </script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="wrap">
        <div class="hdr">
          <a class="brand" href="/">
            <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="2" y="2" width="28" height="28" rx="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 22V12l7-5 7 5v10M13 22v-6h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            <span>{SITE_NAME}<small>Independent. Sourced. Dated.</small></span>
          </a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list">Menu</button>
        </div>
        <nav class="site-nav" aria-label="Main">
          <ul class="nav-list" id="nav-list">
            {nav.map((n) => <li><a href={n.href} aria-current={n.on ? 'page' : undefined}>{n.name}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    {crumbs.length > 0 && (
      <div class="wrap" data-pagefind-ignore>
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c, i) => <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c.name}</span>}</li>)}
          </ol>
        </nav>
      </div>
    )}
    <main id="main" class="wrap" {...(isNoindex && robotsValue !== 'noindex, follow' ? {} : { 'data-pagefind-body': '', 'data-pagefind-filter': `page_type:${pageType}` })}>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap">
        <div class="cols">
          <div>
            <p><strong>{SITE_NAME}</strong></p>
            <p>Free and independent. No paid listings, no ads, no accounts. Facts come from public sources, each with a source and a date. Unknown values are left blank, never guessed.</p>
          </div>
          <div>
            <h2>Trust</h2>
            <ul>
              <li><a href="/methodology/">Methodology</a></li>
              <li><a href="/corrections/">Contact and corrections</a></li>
              <li><a href="/corrections-log/">Corrections log</a></li>
              <li><a href="/privacy/">Privacy</a></li>
            </ul>
          </div>
          <div>
            <h2>Explore</h2>
            <ul>
              <li><a href="/about/">About this site</a></li>
              <li><a href="/site-map/">All pages, A to Z</a></li>
            </ul>
          </div>
        </div>
        <p class="small mt-6">Service areas: Franklin, Delaware, Fairfield and Licking counties, Ohio.{s.lastDataUpdate && <> Last site data update: <time datetime={s.lastDataUpdate}>{fmtDate(s.lastDataUpdate)}</time>.</>}</p>
      </div>
    </footer>
    <script>import '../scripts/nav.js';import '../scripts/analytics.js';</script>
  </body>
</html>
