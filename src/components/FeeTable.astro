---
// Fee comparison table (UX spec section 6). Cards on mobile, real table from 48rem. Every row has its source and dates.
import FeeValue from './FeeValue.astro';
import Badge from './Badge.astro';
import SourceNote from './SourceNote.astro';
import Unknown from './Unknown.astro';
import { EXAMPLE_RENT } from '../lib/estimate.mjs';
import { yearText, yearNotes } from '../lib/firstyear.mjs';
import { FEE_GUIDES } from '../lib/feeguides.mjs';
import { getSite } from '../lib/site.mjs';
interface Props { rows: any[]; caption: string; compare?: boolean; flagDays: number }
const { rows, caption, compare = false, flagDays } = Astro.props;
const site = getSite();
// F19: the one-sentence definition from the fee guide wording, as a keyboard-operable disclosure (no hover tooltip). Links to the guide only when it is published.
const gloss = (k) => { const g = FEE_GUIDES[k]; const pg = site.planned.find((p) => p.type === 'fee-guide' && p.fee_type === k && p.eligible); return { text: g.definition, href: pg ? pg.path : null }; };
const COLS = [['management_pct', 'Management %'], ['flat_fee', 'Flat fee'], ['leasing_fee', 'Leasing fee'], ['renewal_fee', 'Renewal fee']];
// Range bar for the management percent: 0 to 12 percent scale, decorative (the number beside it is the fact).
const SCALE_MAX = 12;
const pctSpan = (v) => {
  if (!v || v.type !== 'pct_of_rent') return null;
  const n = [v.value, v.min, v.max, ...(v.plans || []).flatMap((p) => [p.value, p.min, p.max])].filter((x) => typeof x === 'number');
  return n.length ? [Math.min(...n), Math.max(...n)] : null;
};
const bar = (v) => { const sp = pctSpan(v); if (!sp) return null; const lo = Math.min(sp[0], SCALE_MAX), hi = Math.min(sp[1], SCALE_MAX); return { left: (lo / SCALE_MAX) * 100, width: Math.max(((hi - lo) / SCALE_MAX) * 100, 4) }; };
---
<div class="fee-wrap" tabindex="0" role="region" aria-label={caption}>
  <table class="fee-table sticky" id="fee-table">
    <caption class="sr">{caption}</caption>
    <thead>
      <tr class="grp">
        <th scope="col" aria-hidden="true"></th>
        <th scope="colgroup" colspan="2" class="sep">Ongoing</th>
        <th scope="colgroup" colspan="2" class="sep">One-time</th>
        <th scope="col" colspan="3" class="sep" aria-hidden="true"></th>
      </tr>
      <tr>
        <th scope="col">Company</th>
        <th scope="col">Management %<br /><small class="muted">basis as published</small><details><summary>What is this?</summary><p class="small">{gloss('management_pct').text}{gloss('management_pct').href && <> <a href={gloss('management_pct').href}>Read the guide</a></>}</p></details></th>
        <th scope="col">Flat fee<br /><small class="muted">period as published</small><details><summary>What is this?</summary><p class="small">{gloss('flat_fee').text}{gloss('flat_fee').href && <> <a href={gloss('flat_fee').href}>Read the guide</a></>}</p></details></th>
        <th scope="col">Leasing fee<details><summary>What is this?</summary><p class="small">{gloss('leasing_fee').text}{gloss('leasing_fee').href && <> <a href={gloss('leasing_fee').href}>Read the guide</a></>}</p></details></th>
        <th scope="col">Renewal fee<details><summary>What is this?</summary><p class="small">{gloss('renewal_fee').text}{gloss('renewal_fee').href && <> <a href={gloss('renewal_fee').href}>Read the guide</a></>}</p></details></th>
        <th scope="col">Minimums</th>
        <th scope="col">First-year cost, an illustration<br /><small class="muted">from published figures, at ${EXAMPLE_RENT.toLocaleString('en-US')} example rent</small></th>
        <th scope="col">How we checked it, and source</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">
            {compare && <input class="js-only inline" type="checkbox" aria-label={`Select ${r.company.name}${r.ptName ? ` (${r.ptName})` : ''} to compare`} />}
            {r.path ? <a href={r.path}>{r.company.name}</a> : r.company.name}
            <br /><small class="muted">{r.ptName ? `Fees for: ${r.ptName}` : 'No property type stated for these fees'}</small>
            {r.caveat && <><br /><small class="caveat"><strong>Note:</strong> {r.caveat}</small></>}
          </th>
          {COLS.map(([k, label], i) => { const b = k === 'management_pct' ? bar(r.fee[k]) : null; return (
            <td class={i === 0 || i === 2 ? 'sep' : undefined}><span class="lbl">{label}</span><FeeValue value={r.fee[k]} />{b && <span class="scale" aria-hidden="true"><i style={`left:${b.left.toFixed(1)}%;width:${b.width.toFixed(1)}%`}></i></span>}</td>
          ); })}
          <td class="sep"><span class="lbl">Minimums</span><span class="v">{r.minimums ? r.minimums : <Unknown />}</span></td>
          <td class="sep"><span class="lbl">First-year cost</span><span class="v">{r.year ? <><span data-year={JSON.stringify(r.year)}>{yearText(r.year, EXAMPLE_RENT)}</span><small class="muted"><br />{yearNotes(r.year)}</small></> : (r.revenue ? 'Not converted: fee is based on booking revenue, not rent' : 'Not enough published data: no management percent or monthly flat fee')}</span></td>
          <td class="how sep">
            <span class="lbl">How we checked it</span>
            <span class="v"><Badge kind={r.badge.kind} text={r.badge.text} />
              {r.badge.kind === 'stale' && <span class="src">Over {flagDays} days old. Check the company site before relying on it.</span>}
              <SourceNote sourceId={r.fee.source_id} captured={r.fee.captured_date} verified={r.fee.last_verified_date} urls={r.fee.source_urls} who={r.company.name} />
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
