---
// Result card (UX spec 5.1): name link, license + freshness badges, four fee facts in table-column order, one source line.
import Badge from './Badge.astro';
import FeeValue from './FeeValue.astro';
import SourceNote from './SourceNote.astro';
import { describeFee, freshnessBadge, feeBadge, licenseBadge } from '../lib/fees.mjs';
import { getSite } from '../lib/site.mjs';
interface Props { page: any; }
const { page } = Astro.props;
const s = getSite();
const c = page.company;
const FACTS = [['management_pct', 'Management'], ['flat_fee', 'Flat fee'], ['leasing_fee', 'Leasing'], ['renewal_fee', 'Renewal']];
const rows = page.verifiedFeeRows;
const pick = (k) => { for (const f of rows) if (describeFee(f[k])) return f; return null; };
const newest = [...rows].sort((a, b) => b.last_verified_date.localeCompare(a.last_verified_date))[0];
const fb = newest ? feeBadge(newest, s.today, s.quality.freshness.displayFlagDays) : freshnessBadge(c.last_verified_date, s.today, s.quality.freshness.displayFlagDays);
const factTypes = new Set(FACTS.map(([k]) => pick(k)).filter(Boolean).map((f) => f.property_type));
const oneType = factTypes.size === 1 && [...factTypes][0] ? s.ptById.get([...factTypes][0]).name : null;
const lb = licenseBadge(c.license, s.today);
const host = c.website ? new URL(c.website).host.replace(/^www\./, '') : null;
const types = c.property_types_served.map((x) => s.ptById.get(x.property_type_id)).filter(Boolean);
---
<li class="card result" data-types={types.map((t) => t.slug).join(' ')} data-fees={rows.length ? 'yes' : 'no'}>
  <h3><a href={page.path}>{c.name}</a></h3>
  <div class="meta"><Badge kind={lb.kind} text={lb.text} /><Badge kind={fb.kind} text={fb.text} />{c.website && <a class="small muted" href={c.website} rel="nofollow noopener">{host}<span class="sr"> (company website for {c.name})</span></a>}</div>
  {rows.length === 0 ? (
    <p class="compact">No fee data recorded yet. Fees may exist on <a href={c.website || page.path} {...(c.website ? { rel: 'nofollow noopener' } : {})}>{c.website ? <>the company's own site<span class="sr"> ({c.name})</span></> : 'its profile'}</a>.</p>
  ) : (
  <div class="facts">
    {FACTS.map(([k, label]) => { const f = pick(k); return (
      <div><span>{label}</span><span>{f ? <><FeeValue value={f[k]} />{f.property_type && !oneType && <small class="muted"> ({s.ptById.get(f.property_type).name})</small>}</> : <span class="unk">{rows.length ? 'Not published' : 'Not checked yet'}</span>}</span></div>
    ); })}
  </div>
  )}
  {newest && <SourceNote sourceId={newest.source_id} captured={newest.captured_date} verified={newest.last_verified_date} urls={[]} who={c.name} />}
  {fb.kind === 'stale' && newest && <p class="small">{fb.text}. They may have changed. Check the company site before relying on them.</p>}
  {types.length > 0 && <p class="small muted">Property types: {types.map((t) => t.name).join(', ')}</p>}
</li>
