---
// Text badge. The check mark is decorative; the words carry the meaning.
interface Props { kind: 'ok' | 'none' | 'stale' | 'bad'; text: string }
const { kind, text } = Astro.props;
---
<span class={`badge ${kind}`}>{kind === 'ok' && <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 6.5l2.5 2.5L10 3.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>}{(kind === 'stale' || kind === 'bad') && <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 1.5l5 9H1z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>}{text}</span>
