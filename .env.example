# Public name of the site (header, footer, page titles, structured data, fee-data export). Default: Central Ohio Property Management Guide.
PUBLIC_SITE_NAME=

# GA4 measurement ID. Leave unset to omit the analytics tag.
PUBLIC_GA_ID=
# Production origin, used for canonical URLs, sitemap and robots.txt.
SITE_URL=https://your-domain.example
# Scraper only: a page where site owners can reach the operator. Sent in the User-Agent. Required by npm run scraper:run.
SCRAPER_CONTACT_URL=
# Correction form: https endpoint of the hosted form tool (the form POSTs there) and a visible email fallback.
# If NEITHER is set the build warns loudly, /corrections/ says it cannot receive requests, and strict builds fail.
PUBLIC_FORM_ACTION=
PUBLIC_CONTACT_EMAIL=
# About page (owner decisions): who operates the site, and the related-business disclosure (plain sentence).
PUBLIC_OPERATOR_NAME=
PUBLIC_DISCLOSURE=
# Set to 1 (or use npm run build:strict) to make the build fail on unset launch configuration.
STRICT_BUILD=
