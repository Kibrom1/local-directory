{
  "$description": "Design tokens for Central Ohio Property Management Guide. Contrast ratios computed with the WCAG 2.x relative-luminance formula (docs/ux/accessibility-checklist.md). CSS custom properties in prototype/style.css mirror these values.",
  "color": {
    "ink": {
      "value": "#16202a",
      "use": "body text",
      "contrast": {
        "on bg #ffffff": 16.48,
        "on surface": 14.48
      }
    },
    "muted": {
      "value": "#4b535d",
      "use": "secondary text, hints, source notes",
      "contrast": {
        "on bg": 7.79,
        "on surface": 6.85,
        "on unknown-bg": 6.6
      }
    },
    "bg": {
      "value": "#fbfaf7"
    },
    "surface": {
      "value": "#f3f0e9",
      "use": "panels, filters, table header"
    },
    "line": {
      "value": "#e2ddd2",
      "use": "decorative dividers only (not required for understanding)"
    },
    "ui": {
      "value": "#6b6f76",
      "use": "borders of inputs, buttons, cards (UI component boundary)",
      "contrast": {
        "on bg (needs 3:1)": 4.84
      }
    },
    "primary": {
      "value": "#0f4c75",
      "use": "links, primary button background",
      "contrast": {
        "on bg": 9.09,
        "on surface": 7.98,
        "white text on primary": 9.09
      }
    },
    "focus": {
      "value": "#0b3d91",
      "use": "3px focus outline, 2px offset",
      "contrast": {
        "on bg": 10.04,
        "on surface": 8.83
      }
    },
    "warn": {
      "bg": "#fff1cc",
      "ink": "#5a3b00",
      "line": "#8a5a00",
      "use": "freshness banner, stale badge",
      "contrast": {
        "ink on bg": 9.08,
        "line on white (needs 3:1)": 5.93
      }
    },
    "success": {
      "bg": "#e3f2e9",
      "ink": "#0d5530",
      "use": "verified badge only",
      "contrast": {
        "ink on bg": 7.69,
        "ink on white": 8.9
      }
    },
    "danger": {
      "bg": "#fbe9e6",
      "ink": "#9b1c10",
      "use": "form errors",
      "contrast": {
        "ink on bg": 6.97,
        "ink on white": 8.18
      }
    },
    "info": {
      "bg": "#e6eff6",
      "ink": "#16202a",
      "use": "scope/labeling notes (reviewed, not average)",
      "contrast": {
        "ink on bg": 14.16
      }
    },
    "neutralBadge": {
      "bg": "#efece4",
      "ink": "#4b535d",
      "use": "unverified / not checked badge",
      "contrast": {
        "ink on bg": 6.6,
        "border on bg (needs 3:1)": 4.28
      }
    },
    "unknown": {
      "bg": "#efece4",
      "ink": "#4b535d",
      "use": "\"Not published\" chip (always text, never color alone)",
      "contrast": {
        "ink on bg": 6.6
      }
    },
    "footer": {
      "bg": "#14202b",
      "ink": "#e8ebef",
      "link": "#ffffff",
      "contrast": {
        "ink on bg": 13.81,
        "link on bg": 16.52
      }
    }
  },
  "typography": {
    "family": {
      "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "note": "System fonts only: no web-font request, no layout shift."
    },
    "scale": {
      "xs": "0.75rem/1.4",
      "sm": "0.875rem/1.5",
      "base": "1rem/1.6",
      "lg": "1.125rem/1.6",
      "h3": "1.125rem/1.3",
      "h2": "1.375rem/1.25",
      "h1-mobile": "1.75rem/1.2",
      "h1-desktop": "2.25rem/1.2"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "measure": "max 42rem for prose (about 70 characters)",
    "minBodySize": "1rem; allow 200% zoom and text-size override"
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "pill": "1rem"
  },
  "breakpoints": {
    "mobile": "0 (default, styles written mobile first)",
    "sm": "40rem (640px): 2-col grids, form label/value rows",
    "md": "48rem (768px): horizontal nav, fee table switches from cards to table",
    "lg": "64rem (1024px): profile/guide two-column with 18rem side slot"
  },
  "layout": {
    "maxWidth": "68rem",
    "pageGutter": "1rem",
    "touchTargetMin": "2.75rem (44px), exceeds WCAG 2.2 2.5.8 minimum of 24px"
  },
  "motion": {
    "policy": "No animation required; honor prefers-reduced-motion; no parallax, carousels or autoplay"
  },
  "components": {
    "button": {
      "minHeight": "2.75rem",
      "padding": "0 1.5rem",
      "radius": "md",
      "primary": {
        "bg": "primary",
        "ink": "#ffffff"
      },
      "secondary": {
        "bg": "bg",
        "ink": "primary",
        "border": "primary"
      },
      "disabled": {
        "bg": "unknown.bg",
        "ink": "muted",
        "border": "ui",
        "note": "disabled state keeps aria-disabled and an explanatory status text nearby"
      }
    },
    "input": {
      "minHeight": "2.75rem",
      "border": "1px ui",
      "radius": "md",
      "focus": "3px focus outline",
      "error": "2px danger border plus error text, aria-invalid"
    },
    "badge": {
      "variants": [
        "ok (verified)",
        "none (unverified / not checked)",
        "stale (over 180 days)",
        "bad"
      ],
      "textRule": "every badge has text; icon is decorative",
      "size": "0.8125rem/600"
    },
    "banner": {
      "variants": [
        "warn",
        "info",
        "bad"
      ],
      "border": "6px left accent plus 1px",
      "padding": "0.75rem 1rem"
    },
    "resultCard": {
      "border": "1px ui",
      "radius": "md",
      "padding": "1rem",
      "facts": "2 cols mobile, 4 cols from md"
    },
    "feeTable": {
      "mobile": "stacked cards with data-label rows",
      "md": "table, sticky first column when it overflows",
      "rowPadding": "0.75rem",
      "headerBg": "surface"
    },
    "sourceNote": {
      "font": "0.8125rem",
      "ink": "muted"
    }
  }
}
