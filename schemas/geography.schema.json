{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://directory.local/schemas/geography.schema.json",
  "title": "geography.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "name", "slug", "state", "parent_id"],
    "properties": {
      "id": { "$ref": "common.schema.json#/definitions/geographyId" },
      "type": { "enum": ["metro", "county", "city", "school_district"] },
      "name": { "type": "string", "minLength": 1 },
      "slug": { "$ref": "common.schema.json#/definitions/slug" },
      "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "parent_id": { "anyOf": [{ "$ref": "common.schema.json#/definitions/geographyId" }, { "type": "null" }] }
    }
  }
}
