{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://directory.local/schemas/sources.schema.json",
  "title": "sources.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "url", "access_method", "robots_txt_checked_date", "robots_decision", "tos_checked_date", "tos_decision", "use_allowed"],
    "properties": {
      "id": { "$ref": "common.schema.json#/definitions/sourceId" },
      "name": { "type": "string", "minLength": 1 },
      "url": { "type": "string", "format": "uri" },
      "access_method": { "enum": ["api", "bulk_download", "scrape", "manual_public_lookup"] },
      "robots_txt_checked_date": { "anyOf": [{ "$ref": "common.schema.json#/definitions/date" }, { "type": "null" }] },
      "robots_decision": { "enum": ["allowed", "disallowed", "no_robots_txt", "not_checked"] },
      "tos_checked_date": { "anyOf": [{ "$ref": "common.schema.json#/definitions/date" }, { "type": "null" }] },
      "tos_decision": { "enum": ["allowed", "prohibits_automated_access", "silent", "not_checked"] },
      "use_allowed": { "type": "boolean", "description": "False means no record may cite this source." },
      "decision_notes": { "type": ["string", "null"], "maxLength": 500 },
      "placeholder": { "type": "boolean" }
    }
  }
}
