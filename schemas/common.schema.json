{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://directory.local/schemas/common.schema.json",
  "title": "Shared definitions",
  "definitions": {
    "date": { "type": "string", "format": "date" },
    "url": { "type": "string", "format": "uri" },
    "sourceId": { "type": "string", "pattern": "^src_[a-z0-9_]+$" },
    "companyId": { "type": "string", "pattern": "^co_[a-z0-9_]+$" },
    "geographyId": { "type": "string", "pattern": "^geo_[a-z0-9_]+$" },
    "propertyTypeId": { "type": "string", "pattern": "^pt_[a-z0-9_]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "provenanceProps": {
      "type": "object",
      "properties": {
        "source_id": { "$ref": "#/definitions/sourceId" },
        "captured_date": { "$ref": "#/definitions/date" },
        "last_verified_date": { "$ref": "#/definitions/date" }
      },
      "required": ["source_id", "captured_date", "last_verified_date"]
    },
    "money": { "type": ["number", "null"], "minimum": 0 },
    "feePlan": {
      "description": "One plan or tier inside a fee (for example Core/Signature, or 1 home / 2 homes). Shares type and period with the parent fee value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 60, "description": "Plan name as published, or null." },
        "condition": { "type": ["string", "null"], "maxLength": 80, "description": "When the plan applies, for example '2-19 units'." },
        "label_confirmed": { "type": "boolean", "description": "False when the plan name was inferred (for example from column order) and not stated next to the value." },
        "value": { "type": ["number", "null"], "minimum": 0 },
        "min": { "type": ["number", "null"], "minimum": 0 },
        "max": { "type": ["number", "null"], "minimum": 0 },
        "minimum_usd": { "type": ["number", "null"], "minimum": 0, "description": "Floor in USD when the company states 'greater of X or Y'." }
      },
      "anyOf": [
        { "type": "object", "properties": { "value": { "type": "number" } }, "required": ["value"] },
        { "type": "object", "properties": { "min": { "type": "number" } }, "required": ["min"] },
        { "type": "object", "properties": { "max": { "type": "number" } }, "required": ["max"] }
      ]
    },
    "feeValueObject": {
      "description": "A fee that may be a single number (value), a range (min and/or max) or plan-based (plans). Do not collapse ranges or plans into one number.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["flat_usd", "pct_of_monthly_rent", "pct_of_rent"], "description": "pct_of_monthly_rent = percent of one month's rent (leasing, renewal); pct_of_rent = percent of rent (management)." },
        "period": { "enum": ["one_time", "monthly", "per_unit_monthly", "annual", null] },
        "value": { "type": ["number", "null"], "minimum": 0 },
        "min": { "type": ["number", "null"], "minimum": 0 },
        "max": { "type": ["number", "null"], "minimum": 0 },
        "minimum_usd": { "type": ["number", "null"], "minimum": 0, "description": "Floor in USD when the company states 'greater of X or Y'." },
        "basis": { "type": ["string", "null"], "maxLength": 120, "description": "What the number applies to, in the company's words (for example 'collected rent', 'first month's rent')." },
        "plans": { "type": "array", "items": { "$ref": "#/definitions/feePlan" } },
        "notes": { "type": ["string", "null"], "maxLength": 200 }
      },
      "anyOf": [
        { "type": "object", "properties": { "value": { "type": "number" } }, "required": ["value"] },
        { "type": "object", "properties": { "min": { "type": "number" } }, "required": ["min"] },
        { "type": "object", "properties": { "max": { "type": "number" } }, "required": ["max"] },
        { "type": "object", "properties": { "plans": { "type": "array", "minItems": 1 } }, "required": ["plans"] }
      ]
    },
    "feeValue": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/feeValueObject" }]
    }
  }
}
