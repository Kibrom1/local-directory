{
  "name": "columbus-pm-directory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "dev": "astro dev",
    "build": "npm run validate && astro build && pagefind --site dist",
    "preview": "astro preview",
    "validate:strict": "node scripts/validate.mjs --strict",
    "freshness": "node scripts/freshness.mjs",
    "report": "node scripts/report.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "scraper:run": "node scripts/scraper/run.mjs",
    "build:strict": "npm run validate:strict && STRICT_BUILD=1 astro build && pagefind --site dist && node scripts/check-site.mjs --strict",
    "check:site": "node scripts/check-site.mjs",
    "check:a11y": "node scripts/a11y.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "check:weight": "node scripts/weights.mjs",
    "redirects:sync": "node scripts/redirects.mjs",
    "paths:snapshot": "node scripts/redirects.mjs --snapshot",
    "launch:check": "node scripts/launch-check.mjs",
    "queue": "node scripts/queue.mjs",
    "guides:check": "node scripts/guides-check.mjs",
    "scraper:review": "node scripts/scraper/review.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.11",
    "marked": "^18.2.0",
    "pagefind": "^1.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^25.17.0"
  }
}
